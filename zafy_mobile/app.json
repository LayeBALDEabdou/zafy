{
  "expo": {
    "name": "Zafy",
    "slug": "zafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/zafy-icon.png",
    "scheme": "zafy",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/zafy-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "app.zafy.wallet"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13213A",
        "foregroundImage": "./assets/images/zafy-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.zafy.wallet",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13213A",
          "image": "./assets/images/zafy-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Zafy utilise Face ID pour déverrouiller ton wallet."
        }
      ],
      "@breeztech/breez-sdk-spark-react-native",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Zafy utilise la caméra pour scanner les QR codes de paiement.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#13213A"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b235a0f0-f01e-47ea-abcd-f9f7cbaac28a"
      }
    }
  }
}
